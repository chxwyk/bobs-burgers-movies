# Discord Developer Portal -> Bot -> Reset/Copy Token
DISCORD_TOKEN=replace_with_your_movie_bot_token

# Your Discord server ID. Keep this set while testing so commands sync immediately.
DEV_GUILD_ID=

# Built-in server roles. These are already set for your server.
MOVIE_STAFF_ROLE_ID=1535138119664402443
CUSTOMER_NOTIFICATION_ROLE_ID=1515866262306033737

# Railway: attach a persistent volume at /app/data.
DATABASE_PATH=data/movie_orders.db
TRANSCRIPT_DIR=data/transcripts

LOG_LEVEL=INFO
